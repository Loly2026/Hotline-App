{
  "expo": {
    "name": "Hotline App",
    "slug": "hotline-egypt",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "hotlineapp",
    "runtimeVersion": "1.0.0",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "expo-notifications",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1118900297282275~4780950351"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hotline.egypt",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hotline.egypt",
      "versionCode": 34,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f7e8f3"
      }
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#b30f7f",
      "enforceContrast": false
    },
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#0f0618",
      "resizeMode": "contain"
    },
    "extra": {
      "appName": "Hotline App",
      "apiBaseUrl": "@env:EXPO_PUBLIC_API_URL",
      "eas": {
        "projectId": "ad40b21c-50ba-4e75-81ed-b21f3df612d6"
      }
    }
  }
}
